# Copy to .env.staging.local (gitignored). Do not paste secrets into chat.
# Exclusive test accounts only: three mailboxes you control, never client users.
# Do not use @example.test or other reserved domains; they do not receive OTP mail.

STAGING_BASE_URL=https://portal.majoriti.world
STAGING_SUPABASE_URL=https://oaqjpyhbxagrelhwzyuq.supabase.co
STAGING_SUPABASE_ANON_KEY=

# Comma-separated allowlist. Must be exactly the three test accounts below.
STAGING_ALLOWED_EMAILS=
STAGING_ALLOWED_IDS=

STAGING_PARTICIPANT_EMAIL=
STAGING_OTHER_EMAIL=
STAGING_MAJORITI_EMAIL=

STAGING_PARTICIPANT_ID=
STAGING_OTHER_ID=
STAGING_MAJORITI_ID=
STAGING_PROJECT_ID=

# JWTs stay here, never in chat or git. Public anon key only; never service_role.
STAGING_PARTICIPANT_ACCESS_TOKEN=
STAGING_OTHER_ACCESS_TOKEN=
STAGING_MAJORITI_ACCESS_TOKEN=

STAGING_PARTICIPANT_STORAGE_STATE=tests/staging/.auth/participant.json
STAGING_OTHER_STORAGE_STATE=tests/staging/.auth/other.json
STAGING_INTERVIEW_PATH=/portal/entrevista/
# Entrevista QA nueva para oferta de cierre → recarga. No reutilices una ya completada.
STAGING_INTERVIEW_CLOSE_PATH=/portal/entrevista/
STAGING_LIVE_CHAT=0
