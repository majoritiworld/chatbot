# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Legacy Drizzle (optional; consulting domain uses Supabase)
POSTGRES_URL=

# https://vercel.com/docs/redis
REDIS_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never exposed to the client. Sign-in needs it to check that an
# email was invited and to create the Auth account behind the scenes.
SUPABASE_SERVICE_ROLE_KEY=
# Must match the deployed origin: invite mails are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Auth dashboard setup (the login fails without this) ---
#
# 1. Authentication > URL Configuration
#    Site URL           = the same value as NEXT_PUBLIC_SITE_URL
#    Redirect URLs      = <site>/auth/callback
#
# 2. Authentication > Emails > Magic Link
#    https://supabase.com/dashboard/project/_/auth/templates
#    Subject: Tu código de acceso a Majoriti
#    Body:    paste supabase/email-templates/magic-link.html
#    The hosted template is what actually gets mailed. If it still has
#    {{ .ConfirmationURL }}, users receive a sign-in link (and scanners
#    click it, so the OTP dies). The body must be {{ .Token }}
#    only — no links.
#
# 3. Authentication > Emails > Invite user
#    Paste supabase/email-templates/invite.html
#    It links to /auth/callback with the hashed token, so the invite also opens
#    on a phone. The default {{ .ConfirmationURL }} is a PKCE link and does not.
#
# 4. Project Settings > Authentication > SMTP: configure a real sender.
#    The built-in service is rate limited to a handful of mails per hour.
#
# 5. Majoriti operators sign in with email + password at /login/admin.
#    Set that password in Authentication > Users, not in this file.

# OpenAI Whisper transcription
OPENAI_API_KEY=
